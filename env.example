# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExampleTokenHere

# ID чата, где сидит Iris и куда добавлен ваш бот (обычно отрицательное число для групп)
CHAT_ID=-1001234567890

# Username бота Iris в этом чате, без @ (например iris_cm_bot).
# Оставьте пустым, если не уверены — тогда фильтрация идёт только по тексту ответа.
IRIS_USERNAME=iris_cm_bot

# Расписание запроса статистики в формате cron (по умолчанию — каждые 6 часов)
CRON_SCHEDULE=0 */6 * * *

# Точная команда, которую бот будет присылать в чат
STATS_COMMAND=Стата вся

# Домен вашего сайта — для CORS. Можно временно оставить *
ALLOWED_ORIGIN=https://your-site.com

PORT=3000
